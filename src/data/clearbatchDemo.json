{
  "type": "ClearBatchApp",
  "version": "2.1",
  "meta": {
    "name": "ClearBatch System Diagnostics & Benchmark Suite",
    "author": "Samsoft Corporation",
    "description": "Native Win32 JSON-driven user interface and batch processing engine for Samsoft FXP OS."
  },
  "window": {
    "title": "ClearBatch System Diagnostics & Automation Suite",
    "width": 640,
    "height": 540,
    "icon": "https://img.icons8.com/color/48/000000/processor.png"
  },
  "initialState": {
    "benchmarkType": "cpu",
    "iterations": "50000",
    "stressLevel": "Standard",
    "enableLogging": true,
    "autoFlush": true,
    "sourcePath": "C:/Documents",
    "targetPath": "C:/Desktop",
    "batchAction": "Scan & Validate Files",
    "filterExt": "*.txt;*.exe",
    "cpuScore": "Pending test...",
    "memoryScore": "Pending test...",
    "diskScore": "Pending test...",
    "statusMessage": "ClearBatch v2.1 runtime ready on ${$OS} (the current HUGE update \":)\"). Select an automated task or benchmark."
  },
  "menu": [
    {
      "text": "File",
      "items": [
        { "text": "Open Batch Definition...", "action": "openBatchFile" },
        { "text": "Save Diagnostic Report...", "action": "saveReport" },
        { "separator": true },
        { "text": "Exit", "action": "closeApp" }
      ]
    },
    {
      "text": "Operations",
      "items": [
        { "text": "Execute Selected Benchmark", "action": "runBenchmark" },
        { "text": "Execute Batch Automation", "action": "runBatch" },
        { "separator": true },
        { "text": "Reset Form Values", "action": "resetState" }
      ]
    },
    {
      "text": "Help",
      "items": [
        { "text": "About ClearBatch...", "action": "showAbout" }
      ]
    }
  ],
  "tabs": [
    {
      "id": "tabBenchmark",
      "title": "System Benchmark",
      "sections": [
        {
          "type": "group",
          "title": "Benchmark Configuration",
          "fields": [
            {
              "id": "benchmarkType",
              "label": "Test Suite Profile:",
              "type": "dropdown",
              "options": [
                { "value": "cpu", "label": "CPU ALU & FPU Integer Suite" },
                { "value": "memory", "label": "Memory Bandwidth & Latency" },
                { "value": "vfs", "label": "Virtual Storage I/O Throughput" },
                { "value": "full", "label": "Comprehensive System Stress" }
              ]
            },
            {
              "id": "iterations",
              "label": "Calculation Cycles:",
              "type": "text",
              "placeholder": "50000"
            },
            {
              "id": "stressLevel",
              "label": "Thread Load Priority:",
              "type": "dropdown",
              "options": [
                { "value": "Low", "label": "Low (Background Priority)" },
                { "value": "Standard", "label": "Normal (Standard Win32)" },
                { "value": "High", "label": "High (Real-time Priority)" }
              ]
            },
            {
              "id": "enableLogging",
              "label": "Stream real-time performance telemetry to event buffer",
              "type": "checkbox"
            }
          ]
        },
        {
          "type": "group",
          "title": "Execution Progress",
          "fields": [
            {
              "id": "benchProgress",
              "type": "progress",
              "initial": 0
            }
          ]
        },
        {
          "type": "group",
          "title": "Performance Metric Readouts",
          "fields": [
            {
              "id": "metricsSummary",
              "type": "summary",
              "items": [
                { "label": "Target Architecture", "bind": "${$OS}" },
                { "label": "Active User", "bind": "${$USER}" },
                { "label": "CPU Benchmark", "bind": "${cpuScore}" },
                { "label": "RAM Throughput", "bind": "${memoryScore}" },
                { "label": "Virtual Disk I/O", "bind": "${diskScore}" }
              ]
            }
          ]
        }
      ],
      "actions": [
        { "id": "btnRunBench", "text": "Run Benchmark", "isDefault": true, "action": "runBenchmark" },
        { "id": "btnResetBench", "text": "Reset Scores", "action": "resetScores" }
      ]
    },
    {
      "id": "tabBatch",
      "title": "VFS Batch Operations",
      "sections": [
        {
          "type": "group",
          "title": "File System Parameters",
          "fields": [
            {
              "id": "sourcePath",
              "label": "Source Directory:",
              "type": "filePicker",
              "pickerMode": "folder"
            },
            {
              "id": "targetPath",
              "label": "Destination Directory:",
              "type": "filePicker",
              "pickerMode": "folder"
            },
            {
              "id": "batchAction",
              "label": "Operation to Perform:",
              "type": "dropdown",
              "options": [
                { "value": "Scan & Validate Files", "label": "Scan & Validate Files" },
                { "value": "Synchronize VFS Tree", "label": "Synchronize VFS Tree" },
                { "value": "Purge Temporary Files", "label": "Purge Temporary Files" }
              ]
            },
            {
              "id": "filterExt",
              "label": "Target Extensions:",
              "type": "text",
              "placeholder": "*.txt;*.json;*.exe"
            },
            {
              "id": "autoFlush",
              "label": "Automatically commit changes to storage",
              "type": "checkbox"
            }
          ]
        },
        {
          "type": "group",
          "title": "Execution Console",
          "fields": [
            {
              "id": "logOutput",
              "type": "logArea",
              "initialText": "[ClearBatch Engine v2.0 initialized]\nAutomatic UI component auto-fitter ready.\nAwaiting batch instruction..."
            }
          ]
        }
      ],
      "actions": [
        { "id": "btnExecuteBatch", "text": "Execute Batch", "isDefault": true, "action": "runBatch" },
        { "id": "btnClearLog", "text": "Clear Log", "action": "clearLog" }
      ]
    },
    {
      "id": "tabSchema",
      "title": "JSON Schema Viewer",
      "sections": [
        {
          "type": "group",
          "title": "Underlying Declarative JSON Definition (No HTML/CSS)",
          "fields": [
            {
              "id": "jsonCode",
              "type": "jsonViewer"
            }
          ]
        }
      ],
      "actions": [
        { "id": "btnOpenJson", "text": "Open External JSON...", "action": "openBatchFile" },
        { "id": "btnReload", "text": "Reload Definition", "action": "reloadDefinition" }
      ]
    },
    {
      "id": "tabCloud",
      "title": "Remote Services (Inactive)",
      "disabled": true,
      "sections": []
    }
  ],
  "statusBar": {
    "panels": [
      { "bind": "${statusMessage}", "flexGrow": true },
      { "text": "ClearBatch v2.1 Engine", "width": "12rem" }
    ]
  },
  "actions": {
    "showAbout": [
      {
        "task": "dialog",
        "dialogType": "about",
        "title": "About ClearBatch",
        "message": "ClearBatch Declarative UI & Automation Engine\nSamsoft FXP OS 2.1 (the current HUGE update \":)\")\nRuns native Win32 controls from pure JSON definitions."
      }
    ],
    "resetScores": [
      { "task": "set", "key": "cpuScore", "value": "Pending test..." },
      { "task": "set", "key": "memoryScore", "value": "Pending test..." },
      { "task": "set", "key": "diskScore", "value": "Pending test..." },
      { "task": "set", "key": "benchProgress", "value": 0 },
      { "task": "set", "key": "statusMessage", "value": "Benchmark scores reset." }
    ],
    "clearLog": [
      { "task": "set", "key": "logOutput", "value": "[Execution log cleared]\n" },
      { "task": "set", "key": "statusMessage", "value": "Log cleared." }
    ]
  }
}
